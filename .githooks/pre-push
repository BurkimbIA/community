#!/bin/sh
# Guard against publishing drafts.
#
# BurkimbIA/community is public: anything pushed there is readable on GitHub,
# drafts included. Drafts live in BurkimbIA/community-private. This hook only
# lets `main` and `public/*` branches reach the public repo.
#
# Enable once per clone:  git config core.hooksPath .githooks

remote_url="$2"

case "$remote_url" in
  *BurkimbIA/community.git | *BurkimbIA/community) ;;
  *) exit 0 ;;
esac

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/public/*) ;;
    *)
      echo "pre-push: refusing to push '$remote_ref' to the PUBLIC repo ($remote_url)." >&2
      echo "  Drafts go to the private remote: git push private <branch>" >&2
      echo "  To publish, squash into a 'public/<name>' branch first (see README)." >&2
      status=1
      ;;
  esac
done

exit $status
